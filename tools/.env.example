# AI巡回エンジン 設定
# このファイルを .env にコピーし、値を設定してください。
# cp .env.example .env

# ============================================================
# ターゲット
# ============================================================
# スクレイピング対象URL（例: C.R.E.A.M 公式HP）
TARGET_URL=https://example.com/shop-page

# 対象店舗の WordPress post_id（shop 投稿タイプのID）
SHOP_POST_ID=123

# 店舗名（ログタイトル用）
SHOP_NAME=C.R.E.A.M

# ============================================================
# WordPress REST API
# ============================================================
# サイトURL（末尾スラッシュなし）
WP_BASE_URL=https://yoursite.com

# Basic認証: ユーザー名
WP_USER=admin

# Basic認証: アプリケーションパスワード
# 管理画面 > ユーザー > プロフィール > アプリケーションパスワード で生成
WP_APP_PASSWORD=VUXv iM0G PmC9 MJpk Ommb ggzm

# ============================================================
# Gemini API
# ============================================================
# https://aistudio.google.com/app/apikey で取得
GEMINI_API_KEY=AIzaSyB62VU2avUI5kOhP6uXuWacvr19NlLUGxg
