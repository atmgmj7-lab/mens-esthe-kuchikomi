CONTACT_TO_EMAIL=info@mens-esthe-kuchikomi.com
CONTACT_FORM_DRY_RUN=true
# Production: set CONTACT_FORM_DRY_RUN=false and run npm run contact:check-env

# Review submission (WordPress reviews CPT + Application Password)
