# WordPress REST API 認証用（test_get_urls.py 等）
# このファイルを .env にコピーし、実際の値を設定してください。
# cp .env.example .env

# Headless bridgeへ到達する公開URL（末尾のスラッシュなし）
WP_SITE_URL=https://example.com

# WordPress ユーザー名
WP_USER=example-user

# Application Password（WordPress 管理画面で発行）
# ユーザー > プロフィール > アプリケーションパスワード
WP_APP_PASSWORD=

# --- ai_auto_updater.py 用 ---
GEMINI_API_KEY=
DAILY_UPDATE_PROXY_SECRET=

# 巡回件数: 正の整数 / all = 公式URL がある店舗すべて（未設定時は 3）
# CRAWL_LIMIT=all

# 店舗間の待機秒（全店舗バッチ時の負荷緩和。任意）
# SHOP_DELAY_SECONDS=2

# エリアターム ID（任意）。設定時は REST GET .../shop に area=<ID> を付与（例: 日本橋=7）
# AREA_TERM_ID=7
